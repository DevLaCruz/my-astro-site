---
import type { CollectionEntry } from 'astro:content';
import { groupDocsBySection, getDocUrl } from '../lib/docs';

interface Props {
  projectId: string;
  docs: CollectionEntry<'docs'>[];
  currentId: string;
}

const { projectId, docs, currentId } = Astro.props;
const sections = groupDocsBySection(docs);
---

<nav class="docs-sidebar" aria-label="Documentation navigation">
  <div class="docs-sidebar__inner">
    {sections.map((section) => (
      <div class="docs-sidebar__section">
        <span class="docs-sidebar__section-title">{section.name}</span>
        <ul class="docs-sidebar__list" role="list">
          {section.docs.map((doc) => {
            const href = getDocUrl(doc.id, projectId);
            const isActive = doc.id === currentId;
            return (
              <li>
                <a
                  href={href}
                  class:list={[
                    'docs-sidebar__link',
                    { 'docs-sidebar__link--active': isActive },
                  ]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {doc.data.title}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>
</nav>

<style>
  .docs-sidebar {
    position: sticky;
    top: 5.2rem; /* height of topbar */
    height: calc(100vh - 5.2rem);
    overflow-y: auto;
    border-right: 1px solid #e5e7eb;
    padding: 3rem 0;
    scrollbar-width: thin;
    scrollbar-color: #d1d5db transparent;
  }

  .docs-sidebar__inner {
    padding: 0 1.8rem;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .docs-sidebar__section {
    margin-bottom: 2.8rem;
  }

  .docs-sidebar__section-title {
    display: block;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-subtitle, #888);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.8rem;
    padding: 0 0.75rem;
  }

  .docs-sidebar__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .docs-sidebar__link {
    display: block;
    padding: 0.55rem 0.75rem;
    font-size: 1.4rem;
    color: var(--color-text, #555);
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
    border-left: 2px solid transparent;
    line-height: 1.4;
  }

  .docs-sidebar__link:hover {
    background: rgba(0, 121, 208, 0.06);
    color: var(--secondary-color, #0079d0);
  }

  .docs-sidebar__link--active {
    background: rgba(0, 121, 208, 0.09);
    color: var(--secondary-color, #0079d0);
    font-weight: 600;
    border-left-color: var(--secondary-color, #0079d0);
  }
</style>
