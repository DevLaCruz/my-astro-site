---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../../../layouts/DocsLayout.astro';

export async function getStaticPaths() {
  const allDocs = await getCollection('docs');
  const allProjects = await getCollection('projects');

  return allDocs.map((doc) => {
    // doc.id format: "projectId/page-slug"  (e.g. "hashlib/getting-started")
    const slashIdx = doc.id.indexOf('/');
    const projectId = doc.id.slice(0, slashIdx);
    const pageSlug = doc.id.slice(slashIdx + 1);

    const project = allProjects.find((p) => p.id === projectId);

    return {
      params: { project: projectId, slug: pageSlug },
      props: {
        doc,
        projectId,
        projectName: project?.data.name ?? projectId,
      },
    };
  });
}

const { doc, projectId, projectName } = Astro.props;
const { Content } = await render(doc);

// All docs for this project — needed for sidebar and pagination
const projectDocs = await getCollection(
  'docs',
  ({ id }) => id.startsWith(`${projectId}/`),
);
const docs = projectDocs.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<DocsLayout
  projectName={projectName}
  projectId={projectId}
  doc={doc}
  docs={docs}
>
  <Content />
</DocsLayout>
