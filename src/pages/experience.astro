---
import BaseLayout from "../layouts/BaseLayout.astro";

const experiences = [
    {
        years: "2024 – Present",
        company: "CirIAco",
        title: "Lead Architect & Research Author",
        subtitle: "Independent Research • Cryptographic Knowledge Graph Engine",
        bullets: [
            "Architected a machine-native knowledge representation paradigm replacing human-centric documents with cryptographically verifiable atomic information units (Atmo blocks) in a Directed Acyclic Graph (DAG)",
            "Designed a zero-trust provenance mechanism where factual propositions are SHA-256 hashed and parent-linked, eliminating reference drift and citation hallucination",
            "Implemented recursive attribution traversal algorithms allowing inference engines to compute the exact informational lineage of multi-hop answers back to foundational truth nodes",
            "Built deterministic graph traversal operators designed for fast context-window packing and low-overhead token consumption",
        ],
    },
    {
        years: "2024 – Present",
        company: "SumrAI",
        title: "Core Systems & AI Infrastructure Engineer",
        subtitle: "Axtorch • Zero-Trust AI Gateway & FastMCP Runtime",
        bullets: [
            "Designed and implemented a heterogeneous dual-ring agent architecture separating autonomous ReAct reasoning loops (OpenFang/Rust) from sub-500ms token-streaming tool-execution pipelines (Django Ninja + Granian ASGI)",
            "Engineered typed synchronous and asynchronous FastMCP servers enabling frontier models to safely execute parameterized operations, query vector databases, and invoke system tools across HTTP SSE and JSON-RPC",
            "Formulated an information security architecture where sensitive entities are replaced with opaque cryptographic tokens (Rust FFI AES-256-GCM), preventing raw PII leakage to model context windows",
            "Implemented hybrid retrieval pipelines over PostgreSQL 16 + pgvector, combining dense vector embeddings with metadata-filtered queries for context injection under strict token budgets",
        ],
    },
    {
        years: "Jul 2024 – Present",
        company: "NTT DATA",
        title: "Systems Engineer – Enterprise Telemetry & Distributed Systems",
        subtitle: "Mission-Critical Financial Squads • The most important banks in Peru and Ecuador",
        bullets: [
            "Managed 24/7 cross-squad telemetry and anomaly detection for high-volume banking payment rails (Client: The largest Peruvian bank listed on the NYSE The largest Peruvian bank listed on the NYSE); monitored distributed service meshes using Dynatrace, Kibana, and Grafana",
            "Profiled, tuned, and refactored enterprise Oracle and SQL Server query plans across millions of records (Client: The largest Ecuador bank with international operations), eliminating deadlock conditions and reducing query latency by up to 60%",
            "Engineered custom Python integration bots for enterprise ITSM (ServiceNow API) over long-polling architectures, replacing manual workflows with reliable event-driven automation",
            "Implemented defensive degradations, retry backoffs, and queue pacing during high-traffic transactional spikes across distributed banking integrations",
        ],
    },
    {
        years: "2023 – 2024",
        company: "Academic Research (UNPRG)",
        title: "Principal Investigator & ML Engineer",
        subtitle: "Empirical Deep Learning & Signal Processing",
        bullets: [
            "Engineered an end-to-end computer vision pipeline using ResNet50 and ResUNet backbones, optimizing with custom Focal Tversky Loss to overcome severe class imbalance in brain MRI lesion segmentation; achieved Dice Similarity Coefficient >0.88 and IoU >0.80",
            "Developed edge vision inference pipelines deploying quantized EfficientNet models on resource-constrained hardware (Raspberry Pi 4B), sustaining real-time processing (<200ms latency) without cloud backhaul",
            "Conducted empirical PRISMA-compliant systematic reviews analyzing security and auditing frameworks across public cloud infrastructures (AWS/GCP)",
        ],
    },
    {
        years: "Oct 2025",
        company: "MAWJAC AI",
        title: "Lead Infrastructure & ML Engineer",
        subtitle: "NASA Space Apps Challenge — Global Nominee",
        bullets: [
            "Recognized internationally as Global Nominee (top tier of 60,000+ global participants) for architectural design and execution of an AI-driven scientific visualization and telemetry prototype under intense hackathon constraints",
            "Containerized ML inference pipelines with Docker, sustaining sub-200ms processing latencies for astronomical telemetry data",
        ],
    },
];

const research = [
    {
        title: "Machine-Native Knowledge Representation",
        description:
            "Deconstructing human document paradigms into cryptographically verifiable atomic blocks (Atmo) on DAGs to eliminate hallucination at the data structure level.",
        icon: "fa-diagram-project",
    },
    {
        title: "Model Context Protocol & Agentic Tooling",
        description:
            "Engineering typed FastMCP runtimes for low-latency (<500ms) tool execution, pgvector hybrid retrieval, and deterministic multi-agent state handoffs.",
        icon: "fa-network-wired",
    },
    {
        title: "Zero-Trust Vaults for Frontier LLMs",
        description:
            "Formulating opaque entity pseudonymization via Rust FFI (PyO3) to ensure language models reason over relational semantics without ingesting raw PII.",
        icon: "fa-shield-halved",
    },
    {
        title: "Empirical ML & Hard Evaluation Frameworks",
        description:
            "Designing stress tests and out-of-distribution evaluation benchmarks for vision and language models, moving beyond naive aggregate metrics.",
        icon: "fa-flask-vial",
    },
];
---

<BaseLayout title="Experience" activePage="experience">
    <main class="layout__content">
        <section class="content__page content__resume">
            <!-- Header -->
            <header class="resume__header" data-animate="fade-up">
                <h2 class="resume__title">Experience</h2>
            </header>

            <!-- Work Experience Timeline -->
            <div class="resume__container">
                <section class="resume__left" style="flex-basis: 100%;">
                    <div class="resume__timeline">
                        <header
                            class="resume__subheader"
                            data-animate="fade-up"
                        >
                            <h2 class="resume__subtitle">
                                Professional <span class="title__color"
                                    >Experience</span>
                            </h2>
                        </header>

                        {
                            experiences.map((exp, i) => (
                                <article
                                    class="timelines__timeline timeline-dot-pulse"
                                    data-animate="fade-up"
                                    data-delay={String((i % 4) + 1)}
                                >
                                    <header class="timeline__header">
                                        <h3 class="timeline__year">
                                            {exp.years}
                                        </h3>
                                        <span class="timeline__company">
                                            {exp.company}
                                        </span>
                                    </header>
                                    <div class="timeline__divider" />
                                    <div class="timeline__description">
                                        <h3 class="timeline__title">
                                            {exp.title}
                                        </h3>
                                        <span class="exp-subtitle">
                                            {exp.subtitle}
                                        </span>
                                        <ul class="exp-bullets">
                                            {exp.bullets.map((bullet) => (
                                                <li class="exp-bullet">
                                                    {bullet}
                                                </li>
                                            ))}
                                        </ul>
                                    </div>
                                </article>
                            ))
                        }
                    </div>
                </section>
            </div>

            <!-- Current Research -->
            <section class="about__services" style="margin-top: 2rem;">
                <header class="services__header" data-animate="fade-up">
                    <h3 class="services__title">
                        Current Research & <span class="title__color"
                            >Active Learning</span>
                    </h3>
                </header>
                <div class="services__container">
                    {
                        research.map((item, i) => (
                            <article
                                class="services__service research-card pulse-glow"
                                data-animate="fade-up"
                                data-delay={String(i + 1)}
                            >
                                <div class="service__icon">
                                    <i
                                        class={`service__real-icon fa-solid ${item.icon}`}
                                    />
                                </div>
                                <div class="service__content">
                                    <h4 class="service__title">{item.title}</h4>
                                    <p class="service__description">
                                        {item.description}
                                    </p>
                                </div>
                            </article>
                        ))
                    }
                </div>
            </section>
        </section>
    </main>
</BaseLayout>

<style>
    .exp-subtitle {
        display: inline-block;
        font-size: 1.2rem;
        color: var(--secondary-color);
        background: rgba(0, 121, 208, 0.08);
        padding: 0.2rem 0.8rem;
        border-radius: 0.3rem;
        margin-bottom: 0.8rem;
        font-weight: 500;
    }

    .exp-bullets {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .exp-bullet {
        position: relative;
        font-size: 1.35rem;
        line-height: 2.2rem;
        color: var(--color-text);
        padding-left: 1.8rem;
        margin-bottom: 0.6rem;
    }

    .exp-bullet::before {
        content: "▸";
        position: absolute;
        left: 0;
        color: var(--secondary-color);
        font-weight: bold;
    }

    .research-card {
        border: 1.5px solid #e5e6e7;
        border-radius: 1.2rem;
        padding: 2.5rem;
        background: #fff;
    }

    .service__description {
        font-size: 1.4rem;
        line-height: 2.2rem;
        color: var(--color-text);
        margin-top: 0.5rem;
    }

    @media (max-width: 585px) {
        .timelines__timeline {
            flex-direction: column;
        }

        .timeline__header {
            text-align: left;
            padding-right: 0;
            margin-bottom: 1rem;
        }

        .timeline__divider {
            display: none;
        }

        .timeline__description {
            width: 100%;
            padding-left: 0;
        }
    }
</style>
