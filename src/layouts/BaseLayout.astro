---
import { ViewTransitions } from "astro:transitions";

interface Props {
    title: string;
    activePage?: string;
}

const { title, activePage = "" } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0, maximum-scale=1"
        />
        <meta
            name="description"
            content="Alejandro De La Cruz — Systems Engineer & ML Research Engineer. Building scalable ML infrastructure and agentic AI systems."
        />
        <title>Alejandro De La Cruz — {title}</title>

        <!-- Fonts & Icons -->
        <link
            rel="stylesheet"
            href="/fonts/fontawesome-free-6.1.2-web/css/all.min.css"
        />
        <link rel="stylesheet" href="/fonts/poppins/poppins.css" />

        <!-- Styles -->
        <link rel="stylesheet" href="/css/reset.css" />
        <link rel="stylesheet" href="/css/scroll.css" />
        <link rel="stylesheet" href="/css/styles.css" />
        <link rel="stylesheet" href="/css/responsive.css" />
        <link rel="stylesheet" href="/css/loader.css" />

        <!-- SPA View Transitions -->
        <ViewTransitions />
    </head>
    <body>
        <div class="layout">
            <!-- Sidebar -->
            <aside class="layout__aside">
                <section class="aside__user-info">
                    <div class="user-info__general">
                        <div class="user-info__container-image">
                            <img
                                src="/img/devlacruz.jpg"
                                class="user-info__image"
                                alt="Alejandro De La Cruz profile photo"
                            />
                        </div>
                        <h2 class="user-info__name">Alejandro De La Cruz</h2>
                        <h4 class="user-info__job">Systems & ML Engineer</h4>
                    </div>

                    <!-- Navigation -->
                    <nav class="layout__menu">
                        <ul class="menu__list">
                            <li class="menu__option">
                                <a
                                    class={`menu__link ${activePage === "home" ? "menu__link--active" : ""}`}
                                    href="/"
                                >
                                    <i class="menu__icon fa-solid fa-house"></i>
                                    <span class="menu__overlay">Home</span>
                                </a>
                            </li>
                            <li class="menu__option">
                                <a
                                    class={`menu__link ${activePage === "about" ? "menu__link--active" : ""}`}
                                    href="/about"
                                >
                                    <i class="menu__icon fa-solid fa-user"></i>
                                    <span class="menu__overlay">About</span>
                                </a>
                            </li>
                            <li class="menu__option">
                                <a
                                    class={`menu__link ${activePage === "experience" ? "menu__link--active" : ""}`}
                                    href="/experience"
                                >
                                    <i class="menu__icon fa-solid fa-briefcase"></i>
                                    <span class="menu__overlay">
                                        Experience
                                    </span>
                                </a>
                            </li>
                            <li class="menu__option">
                                <a
                                    class={`menu__link ${activePage === "projects" ? "menu__link--active" : ""}`}
                                    href="/projects"
                                >
                                    <i class="menu__icon fa-solid fa-code-branch"></i>
                                    <span class="menu__overlay">Projects</span>
                                </a>
                            </li>
                            <li class="menu__option">
                                <a
                                    class={`menu__link ${activePage === "contact" ? "menu__link--active" : ""}`}
                                    href="/contact"
                                >
                                    <i class="menu__icon fa-solid fa-envelope"></i>
                                    <span class="menu__overlay">Contact</span>
                                </a>
                            </li>
                        </ul>
                    </nav>

                    <!-- Social Links -->
                    <div class="user-info__links">
                        <ul class="links__social">
                            <li class="social__option">
                                <a
                                    class="social__link"
                                    href="https://www.linkedin.com/in/alejandro-de-la-cruz/"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    aria-label="LinkedIn"
                                >
                                    <i class="social__icon fa-brands fa-linkedin"></i>
                                </a>
                            </li>
                            <li class="social__option">
                                <a
                                    class="social__link"
                                    href="https://github.com/devlacruz"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    aria-label="GitHub"
                                >
                                    <i class="social__icon fa-brands fa-github"></i>
                                </a>
                            </li>
                        </ul>
                    </div>

                    <div class="user-info__buttons">
                        <a
                            href="/Alejandro_DeLaCruz_ResearchEngineer.pdf"
                            download="Alejandro_DeLaCruz_ResearchEngineer.pdf"
                            class="user-info__btn"
                            data-astro-reload
                        >
                            <i
                                class="fa-solid fa-download"
                                style="margin-right: 0.5rem;"
                            ></i>
                            Download CV
                        </a>
                    </div>

                    <footer class="user-info__footer">
                        &copy; 2026 Alejandro De La Cruz
                    </footer>
                </section>
            </aside>

            <!-- Backdrop for Mobile Drawer -->
            <div class="layout__backdrop" id="layout-backdrop" aria-hidden="true"></div>

            <!-- Mobile Menu Toggle -->
            <button
                class="layout__menu-toggle"
                id="layout-menu-toggle"
                aria-label="Toggle navigation menu"
                aria-expanded="false"
                type="button"
            >
                <i class="menu-toggle__icon fa-solid fa-bars"></i>
                <i class="menu-toggle__icon fa-solid fa-xmark"></i>
            </button>

            <!-- Main Content -->
            <slot />
        </div>

        <!-- Scroll Animations -->
        <style>
            @import "../styles/animations.css";
        </style>

        <script>
            // Re-run on every SPA navigation
            document.addEventListener("astro:page-load", () => {
                // Intersection Observer for scroll animations
                const observer = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (entry.isIntersecting) {
                                entry.target.classList.add("is-visible");
                            }
                        });
                    },
                    {
                        threshold: 0.1,
                        rootMargin: "0px 0px -40px 0px",
                    },
                );

                document.querySelectorAll("[data-animate]").forEach((el) => {
                    el.classList.remove("is-visible");
                    observer.observe(el);
                });

                // Mobile menu controller
                const menuToggle = document.querySelector(".layout__menu-toggle");
                const aside = document.querySelector(".layout__aside");
                const backdrop = document.querySelector(".layout__backdrop");

                if (menuToggle && aside && !menuToggle.hasAttribute("data-bound")) {
                    menuToggle.setAttribute("data-bound", "true");

                    const closeMenu = () => {
                        aside.classList.remove("layout__aside--visible");
                        backdrop?.classList.remove("is-visible");
                        menuToggle.classList.remove("is-open");
                        menuToggle.setAttribute("aria-expanded", "false");
                    };

                    const openMenu = () => {
                        aside.classList.add("layout__aside--visible");
                        backdrop?.classList.add("is-visible");
                        menuToggle.classList.add("is-open");
                        menuToggle.setAttribute("aria-expanded", "true");
                    };

                    menuToggle.addEventListener("click", (e) => {
                        e.stopPropagation();
                        if (aside.classList.contains("layout__aside--visible")) {
                            closeMenu();
                        } else {
                            openMenu();
                        }
                    });

                    // Close on backdrop tap
                    backdrop?.addEventListener("click", closeMenu);

                    // Close on Escape key
                    document.addEventListener("keydown", (e) => {
                        if (e.key === "Escape" && aside.classList.contains("layout__aside--visible")) {
                            closeMenu();
                        }
                    });

                    // Close menu when navigating via aside links
                    aside.querySelectorAll(".menu__link, .user-info__btn").forEach((link) => {
                        link.addEventListener("click", closeMenu);
                    });
                }
            });
        </script>
    </body>
</html>
