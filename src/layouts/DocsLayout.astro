---
import type { CollectionEntry } from 'astro:content';
import { ViewTransitions } from 'astro:transitions';
import DocsSidebar from '../components/DocsSidebar.astro';
import { getDocUrl, getAdjacentDocs } from '../lib/docs';

interface Props {
  projectName: string;
  projectId: string;
  doc: CollectionEntry<'docs'>;
  docs: CollectionEntry<'docs'>[];
}

const { projectName, projectId, doc, docs } = Astro.props;
const { title, description } = doc.data;
const { prev, next } = getAdjacentDocs(docs, doc.id);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — {projectName} docs</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" />

    <!-- Fonts & Icons (same as main site) -->
    <link rel="stylesheet" href="/fonts/fontawesome-free-6.1.2-web/css/all.min.css" />
    <link rel="stylesheet" href="/fonts/poppins/poppins.css" />
    <link rel="stylesheet" href="/css/reset.css" />

    <ViewTransitions />
  </head>

  <body>
    <!-- ── Top navigation bar ── -->
    <header class="docs-topbar">
      <div class="docs-topbar__inner">
        <nav class="docs-topbar__breadcrumb" aria-label="Breadcrumb">
          <a href="/" class="docs-topbar__crumb docs-topbar__crumb--home">
            <i class="fa-solid fa-house"></i>
            <span>devlacruz.tech</span>
          </a>
          <span class="docs-topbar__sep" aria-hidden="true">/</span>
          <a href={`/projects/${projectId}/`} class="docs-topbar__crumb">
            {projectName}
          </a>
          <span class="docs-topbar__sep" aria-hidden="true">/</span>
          <span class="docs-topbar__current">docs</span>
        </nav>

        <div class="docs-topbar__actions">
          <a href={`/projects/${projectId}/`} class="docs-topbar__back">
            <i class="fa-solid fa-arrow-left"></i>
            Back to project
          </a>
        </div>
      </div>
    </header>

    <!-- ── Main grid: sidebar + content ── -->
    <div class="docs-layout">
      <DocsSidebar projectId={projectId} docs={docs} currentId={doc.id} />

      <main class="docs-main" id="docs-content" tabindex="-1">
        <article class="docs-article">
          <!-- Page header -->
          <header class="docs-article__header">
            <h1 class="docs-article__title">{title}</h1>
            {description && (
              <p class="docs-article__lead">{description}</p>
            )}
          </header>

          <!-- Rendered markdown body -->
          <div class="docs-article__body">
            <slot />
          </div>

          <!-- Prev / Next navigation -->
          {(prev || next) && (
            <nav class="docs-pagination" aria-label="Page navigation">
              <div class="docs-pagination__inner">
                {prev ? (
                  <a href={getDocUrl(prev.id, projectId)} class="docs-pagination__item docs-pagination__item--prev">
                    <i class="fa-solid fa-arrow-left"></i>
                    <span>
                      <span class="docs-pagination__label">Previous</span>
                      <span class="docs-pagination__title">{prev.data.title}</span>
                    </span>
                  </a>
                ) : <div />}
                {next && (
                  <a href={getDocUrl(next.id, projectId)} class="docs-pagination__item docs-pagination__item--next">
                    <span>
                      <span class="docs-pagination__label">Next</span>
                      <span class="docs-pagination__title">{next.data.title}</span>
                    </span>
                    <i class="fa-solid fa-arrow-right"></i>
                  </a>
                )}
              </div>
            </nav>
          )}
        </article>
      </main>
    </div>

    <style is:global>
      /* ─── Reset & base ─── */
      *, *::before, *::after { box-sizing: border-box; }

      body {
        margin: 0;
        padding: 0;
        font-family: 'Poppins', -apple-system, BlinkMacSystemFont, sans-serif;
        font-size: 62.5%;  /* 1rem = 10px */
        background: #fff;
        color: #374151;
      }

      /* ─── Topbar ─── */
      .docs-topbar {
        position: sticky;
        top: 0;
        z-index: 50;
        height: 5.4rem;
        background: rgba(255,255,255,0.95);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid #e5e7eb;
      }

      .docs-topbar__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 100%;
        padding: 0 2.4rem;
        max-width: 1400px;
        margin: 0 auto;
      }

      .docs-topbar__breadcrumb {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 1.4rem;
      }

      .docs-topbar__crumb {
        color: #6b7280;
        text-decoration: none;
        transition: color 0.15s;
      }
      .docs-topbar__crumb:hover { color: #0079d0; }

      .docs-topbar__crumb--home {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        font-weight: 600;
        color: #0079d0;
      }
      .docs-topbar__crumb--home:hover { opacity: 0.8; }

      .docs-topbar__sep { color: #d1d5db; }

      .docs-topbar__current { color: #9ca3af; font-size: 1.4rem; }

      .docs-topbar__back {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1.3rem;
        color: #6b7280;
        text-decoration: none;
        padding: 0.45rem 1.1rem;
        border: 1px solid #e5e7eb;
        border-radius: 0.5rem;
        transition: border-color 0.15s, color 0.15s;
      }
      .docs-topbar__back:hover {
        border-color: #0079d0;
        color: #0079d0;
      }

      /* ─── Layout grid ─── */
      .docs-layout {
        display: grid;
        grid-template-columns: 26rem 1fr;
        min-height: calc(100vh - 5.4rem);
      }

      /* ─── Main content area ─── */
      .docs-main {
        padding: 4rem 6rem 7rem;
        overflow-x: hidden;
        min-width: 0;
      }

      /* ─── Article ─── */
      .docs-article__header {
        padding-bottom: 2.5rem;
        margin-bottom: 3.5rem;
        border-bottom: 1px solid #e5e7eb;
      }

      .docs-article__title {
        font-size: 3.4rem;
        font-weight: 700;
        color: #111827;
        line-height: 1.2;
        margin: 0 0 1rem;
        font-family: 'Poppins', sans-serif;
      }

      .docs-article__lead {
        font-size: 1.6rem;
        color: #6b7280;
        line-height: 1.65;
        margin: 0;
      }

      /* ─── Markdown body ─── */
      .docs-article__body { font-size: 10px; } /* reset: children use rem relative to html */

      .docs-article__body h2,
      .docs-article__body h3,
      .docs-article__body h4 {
        font-family: 'Poppins', sans-serif;
        font-weight: 600;
        color: #111827;
        margin-top: 3.5rem;
        margin-bottom: 1.2rem;
        line-height: 1.3;
      }
      .docs-article__body h2 { font-size: 2.2rem; }
      .docs-article__body h3 { font-size: 1.8rem; }
      .docs-article__body h4 { font-size: 1.6rem; }

      .docs-article__body p {
        font-size: 1.5rem;
        line-height: 1.85;
        color: #374151;
        margin: 0 0 1.6rem;
      }

      .docs-article__body a {
        color: #0079d0;
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }
      .docs-article__body a:hover { opacity: 0.75; }

      /* Inline code */
      .docs-article__body code {
        font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
        font-size: 1.25rem;
        background: rgba(0, 121, 208, 0.07);
        color: #0079d0;
        padding: 0.15em 0.45em;
        border-radius: 0.3rem;
        border: 1px solid rgba(0, 121, 208, 0.15);
      }

      /* Code blocks (Shiki) */
      .docs-article__body pre {
        background: #0f172a !important;
        border-radius: 0.8rem;
        padding: 2rem 2.4rem;
        overflow-x: auto;
        margin: 2rem 0 2.4rem;
        border: 1px solid #1e293b;
      }
      .docs-article__body pre code {
        all: unset;
        font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
        font-size: 1.35rem;
        line-height: 1.75;
        color: #e2e8f0;
      }

      /* Lists */
      .docs-article__body ul,
      .docs-article__body ol {
        font-size: 1.5rem;
        line-height: 1.85;
        color: #374151;
        padding-left: 2.2rem;
        margin: 0 0 1.6rem;
      }
      .docs-article__body li { margin-bottom: 0.5rem; }

      /* Tables */
      .docs-article__body table {
        width: 100%;
        border-collapse: collapse;
        font-size: 1.4rem;
        margin: 2rem 0;
        overflow-x: auto;
        display: block;
      }
      .docs-article__body th {
        background: rgba(0, 121, 208, 0.06);
        color: #111827;
        font-weight: 600;
        padding: 0.9rem 1.2rem;
        border: 1px solid #e5e7eb;
        text-align: left;
      }
      .docs-article__body td {
        padding: 0.8rem 1.2rem;
        border: 1px solid #e5e7eb;
        color: #374151;
        vertical-align: top;
      }
      .docs-article__body tr:hover td { background: rgba(0, 121, 208, 0.025); }

      /* Blockquote */
      .docs-article__body blockquote {
        border-left: 3px solid #0079d0;
        padding: 1.2rem 1.8rem;
        margin: 2rem 0;
        background: rgba(0, 121, 208, 0.04);
        border-radius: 0 0.5rem 0.5rem 0;
      }
      .docs-article__body blockquote p {
        margin: 0;
        font-style: italic;
        color: #4b5563;
      }

      /* HR */
      .docs-article__body hr {
        border: none;
        border-top: 1px solid #e5e7eb;
        margin: 3rem 0;
      }

      /* ─── Pagination ─── */
      .docs-pagination {
        margin-top: 5rem;
        padding-top: 3rem;
        border-top: 1px solid #e5e7eb;
      }

      .docs-pagination__inner {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
      }

      .docs-pagination__item {
        display: flex;
        align-items: center;
        gap: 1.2rem;
        padding: 1.6rem 2rem;
        border: 1.5px solid #e5e7eb;
        border-radius: 0.8rem;
        text-decoration: none;
        color: #374151;
        transition: border-color 0.2s, background 0.2s, color 0.2s;
      }
      .docs-pagination__item:hover {
        border-color: #0079d0;
        background: rgba(0, 121, 208, 0.03);
        color: #0079d0;
      }
      .docs-pagination__item--next {
        justify-content: flex-end;
        text-align: right;
      }
      .docs-pagination__label {
        display: block;
        font-size: 1.1rem;
        color: #9ca3af;
        margin-bottom: 0.2rem;
        transition: color 0.2s;
      }
      .docs-pagination__title {
        display: block;
        font-size: 1.4rem;
        font-weight: 600;
      }
      .docs-pagination__item:hover .docs-pagination__label {
        color: #0079d0;
      }

      /* ─── Responsive ─── */
      @media (max-width: 900px) {
        .docs-layout { grid-template-columns: 1fr; }
        .docs-sidebar { display: none; }
        .docs-main { padding: 3rem 2rem 5rem; }
        .docs-article__title { font-size: 2.6rem; }
        .docs-pagination__inner { grid-template-columns: 1fr; }
        .docs-pagination__item--next { justify-content: flex-start; text-align: left; }
      }
    </style>
  </body>
</html>
